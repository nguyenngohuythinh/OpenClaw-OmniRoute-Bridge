<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>OpenClaw OmniRoute Bridge</title>
</head>
<body>
    <h1>OpenClaw OmniRoute Bridge</h1>
    <form action="/connect" method="POST">
        <input type="text" name="baseUrl" placeholder="Base URL (http://127.0.0.1:20128/v1)" required>
        <input type="password" name="apiKey" placeholder="API Key" required>
        <button type="submit">Kiểm tra kết nối</button>
    </form>
</body>
</html>
